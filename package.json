{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:api": "wrangler dev",
    "build": "next build",
    "serve": "next build && wrangler dev",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p worker",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "deploy:production": "wrangler deploy --env=\"\"",
    "deploy:preview": "wrangler deploy --env preview"
  },
  "dependencies": {
    "hono": "^4.13.18",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "packageManager": "pnpm@12.4.1"
}
