{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm content && CONTENT_DRAFTS=true pnpm assets && pnpm run \"/^dev:(content|next)$/\"",
    "dev:content": "content-collections watch",
    "dev:next": "CONTENT_DRAFTS=true next dev",
    "dev:api": "wrangler dev",
    "content": "content-collections build && node scripts/check-content.ts",
    "assets": "node scripts/build-assets.ts",
    "build": "pnpm content && pnpm assets && next build",
    "serve": "pnpm build && wrangler d1 migrations apply DB --local && wrangler dev",
    "typecheck": "pnpm content && next typegen && tsc --noEmit && tsc --noEmit -p worker",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm content && vitest run",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "deploy:production": "node scripts/deploy-config.ts && wrangler d1 migrations apply DB --remote --config wrangler.deploy.jsonc --env=\"\" && wrangler deploy --config wrangler.deploy.jsonc --env=\"\"",
    "deploy:preview": "node scripts/deploy-config.ts && wrangler d1 migrations apply DB --remote --config wrangler.deploy.jsonc --env preview && wrangler deploy --config wrangler.deploy.jsonc --env preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/cloudflare": "^11.14.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@content-collections/cli": "^0.1.9",
    "@content-collections/core": "^0.15.3",
    "@content-collections/mdx": "^0.2.2",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "mdast-util-from-markdown": "^2.1.0",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.4.1"
}
