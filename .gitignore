# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare
.wrangler/
.dev.vars*
!.dev.vars.example

# content collections (generated by `pnpm content`)
.content-collections/

# asset step output (spec 0004, `pnpm assets`)
/.generated/
/public/img/
/public/cv/

# social card step output (feature 13, `pnpm cards`)
/public/og/
/public/favicon.ico
/public/icon.png
/public/apple-icon.png

# deploy copy of wrangler.jsonc with NOTIFY_TO filled in (scripts/deploy-config.ts)
/wrangler.deploy.jsonc
